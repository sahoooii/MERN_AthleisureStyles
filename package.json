{
	"name": "athleisure",
	"version": "1.0.0",
	"description": "eCommerce application with the MERN stack",
	"type": "module",
	"main": "server.js",
	"scripts": {
		"start": "node backend/server.js",
		"server": "nodemon backend/server.js",
		"client": "npm start --prefix frontend",
		"dev": "concurrently \"npm run server\" \"npm run client\"",
		"data:import": "node backend/seeder.js",
		"data:destroy": "node backend/seeder.js -d",
		"build": "npm install && npm install --prefix frontend && npm run build --prefix frontend"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sahoooii/MERN_AthleisureStyles.git"
	},
	"keywords": [],
	"author": "sahoooii",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/sahoooii/MERN_AthleisureStyles/issues"
	},
	"homepage": "https://github.com/sahoooii/MERN_AthleisureStyles#readme",
	"dependencies": {
		"bcryptjs": "^2.4.3",
		"cloudinary": "^1.41.3",
		"colors": "^1.4.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"express": "^4.18.2",
		"express-async-handler": "^1.2.0",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^7.8.7",
		"multer": "^2.0.1",
		"multer-storage-cloudinary": "^4.0.0"
	},
	"devDependencies": {
		"concurrently": "^8.2.1",
		"dotenv": "^16.3.1",
		"nodemon": "^3.0.1"
	}
}
